{
  "name": "realphoto-chatgpt-batch-extension",
  "version": "1.0.1",
  "description": "Chrome MV3: пакетная генерация изображений в открытой вкладке ChatGPT по промптам с promts.vibecods.xyz (RealPhoto Prompt Studio).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node scripts/build.mjs && node --test --test-timeout=900000 tests/e2e/e2e.test.mjs",
    "test:live-site": "node --test --test-timeout=120000 tests/e2e/live-site.test.mjs",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "selfsigned": "^5.5.0"
  }
}
